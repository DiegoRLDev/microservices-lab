{
  "ConnectionStrings": {
    "OrdersDb": "Host=localhost;Port=5432;Database=order_db;Username=postgres;Password=postgres"
  },
  "InventoryGrpc": {
    "Address": "https://localhost:7242"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "OrderCreatedTopic": "order-created",
    "PaymentApprovedTopic": "payment-approved",
    "PaymentRejectedTopic": "payment-rejected",
    "PaymentEventsConsumerGroup": "order-service-payment-events"
  },
  "Resilience": {
    "Inventory": {
      "TimeoutSeconds": 2,
      "RetryAttempts": 2,
      "RetryDelayMilliseconds": 200,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerOpenSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
